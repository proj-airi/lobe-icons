# We only parse @lobehub/icons' published es/*/style.js + components/Avatar.js at build time
# (to rebuild the avatar config); we never import its React components, so skip its peer deps
# (@lobehub/ui, antd, react, react-dom). Avoids dragging in the React tree and the workspace's
# trustPolicy: no-downgrade being tripped by @lobehub/ui's transitive deps.
auto-install-peers=false
